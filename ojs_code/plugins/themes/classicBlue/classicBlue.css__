body {
	background-color: #fff;
	font-family: "Times New Roman", Times, Georgia, serif;
}

a {
	text-decoration: none;
}

a:link {
	color: #069;
}

a:active {
	color: #39c;
}

a:visited {
	color: #069;
}

a:hover {
	color: #EEEEFF;
	background: #069;
}

label.error {
	color: #f60;
}

input.defaultButton {
	color: #EEEEFF;
	background: #069;
}

#container {
	background-color: #fff;
	font-size: 1em;
}

#header {
	min-height: 100px;
	background-color: blue;
}

#headerTitle {
	text-align: center;
}

#header h1 {
	line-height: 2.5;
	font-family: "Times New Roman", Times, Georgia, serif;
	text-transform: uppercase;
	letter-spacing: 10px;
	font-size: 2em;
	background-color: white;
	color:  #fff;
}

#footer {
	background-color: #00548A;
	color:  #fff;
}

#footerContent {
	color:  #fff;
}

#main {
	background-color: #f2f2f2;
	border-top: 2px solid 00548A;
	border-bottom: 1px solid #f2f2f2;
	margin-top: 15px;
}

#main h2 {
	font-family: "Times New Roman", Times, Georgia, serif;
	text-transform: uppercase;
}

#main h3 {
	font-family: "Times New Roman", Times, Georgia, serif;
	text-transform: uppercase;
}

#navbar {
	border-bottom: 4px solid blue;
	text-align: center;
}

#breadcrumb {
	height: 18px;
	line-height: 1.5em;
	text-align: center;
	border-bottom: 1px solid blue;
	padding: 0;
	font-style: italic;
}

#content {
	border-top: 1px solid blue;
}

#content h3 {
	font-family:  "Times New Roman", Times, Georgia, serif;
	text-transform: uppercase;
}

#content h4 {
	font-family:  "Times New Roman", Times, Georgia, serif;
	text-transform: uppercase;
}

#content h5 {
	text-transform: uppercase;
}

span.highlight {
	border-bottom: 1px solid blue;
}

table.listing tr.highlight {
	background: #fcff64;
}

table.listing tr.fastTracked {
	background-color: #EEEEFF;
}

table.listing td.headseparator {
	border-top: 1px solid blue;
}

table.listing td.endseparator {
	border-top: 1px solid blue;
}

span.formError {
	color: #f60;
}

ul.formErrorList {
	color: #f60;
}

div.separator {
	border-bottom: 1px solid blue;
}

#rightSidebar ul, #leftSidebar ul {
	margin-left: 0px;
	padding-left: 0px;
}

#rightSidebar li, #leftSidebar li {
	list-style-type: none;
}

#rightSidebar, #leftSidebar {
	margin-top: 5px;
	border-bottom: 1px solid blue;
}
