O:18:"ADORecordSet_array":38:{s:12:"databaseType";s:5:"array";s:6:"_array";a:0:{}s:6:"_types";N;s:9:"_colnames";N;s:9:"_skiprow1";b:0;s:9:"_fieldarr";N;s:7:"canSeek";b:1;s:12:"affectedrows";b:0;s:8:"insertid";b:0;s:3:"sql";s:1990:"SELECT	o.article_id,
				COUNT(*) AS count
			FROM	articles a,
				published_articles pa,
				issues i,
				article_search_objects o NATURAL JOIN article_search_object_keywords o0 NATURAL JOIN article_search_keyword_list k0, article_search_object_keywords o1 NATURAL JOIN article_search_keyword_list k1, article_search_object_keywords o2 NATURAL JOIN article_search_keyword_list k2, article_search_object_keywords o3 NATURAL JOIN article_search_keyword_list k3, article_search_object_keywords o4 NATURAL JOIN article_search_keyword_list k4, article_search_object_keywords o5 NATURAL JOIN article_search_keyword_list k5, article_search_object_keywords o6 NATURAL JOIN article_search_keyword_list k6, article_search_object_keywords o7 NATURAL JOIN article_search_keyword_list k7, article_search_object_keywords o8 NATURAL JOIN article_search_keyword_list k8, article_search_object_keywords o9 NATURAL JOIN article_search_keyword_list k9
			WHERE	pa.article_id = a.article_id AND
				a.status = 3 AND
				pa.article_id = o.article_id AND
				i.issue_id = pa.issue_id AND
				i.published = 1 AND k0.keyword_text = 'venezuela' AND k1.keyword_text = 'incluyendo' AND o0.object_id = o1.object_id AND o0.pos+1 = o1.pos AND k2.keyword_text = 'caracas' AND o0.object_id = o2.object_id AND o0.pos+2 = o2.pos AND k3.keyword_text = 'confirman' AND o0.object_id = o3.object_id AND o0.pos+3 = o3.pos AND k4.keyword_text = 'una' AND o0.object_id = o4.object_id AND o0.pos+4 = o4.pos AND k5.keyword_text = 'alta' AND o0.object_id = o5.object_id AND o0.pos+5 = o5.pos AND k6.keyword_text = 'seroprevalencia' AND o0.object_id = o6.object_id AND o0.pos+6 = o6.pos AND k7.keyword_text = 'bacteria' AND o0.object_id = o7.object_id AND o0.pos+7 = o7.pos AND k8.keyword_text = 'helicobacter' AND o0.object_id = o8.object_id AND o0.pos+8 = o8.pos AND k9.keyword_text = 'pylori' AND o0.object_id = o9.object_id AND o0.pos+9 = o9.pos AND i.journal_id = '1'
			GROUP BY o.article_id
			ORDER BY count DESC
			LIMIT 500";s:6:"compat";b:0;s:12:"dataProvider";s:6:"native";s:6:"fields";b:0;s:8:"blobSize";i:100;s:3:"EOF";b:1;s:14:"emptyTimeStamp";s:6:"&nbsp;";s:9:"emptyDate";s:6:"&nbsp;";s:5:"debug";b:0;s:11:"timeCreated";i:0;s:4:"bind";b:0;s:9:"fetchMode";i:0;s:10:"connection";b:0;s:10:"_numOfRows";i:0;s:12:"_numOfFields";i:2;s:8:"_queryID";i:1;s:11:"_currentRow";i:-1;s:7:"_closed";b:0;s:7:"_inited";b:1;s:4:"_obj";N;s:6:"_names";N;s:12:"_currentPage";i:-1;s:12:"_atFirstPage";b:0;s:11:"_atLastPage";b:0;s:11:"_lastPageNo";i:-1;s:15:"_maxRecordCount";i:0;s:8:"datetime";b:0;s:11:"oldProvider";s:5:"mysql";s:13:"_fieldobjects";a:2:{i:0;O:8:"stdClass":14:{s:4:"name";s:10:"article_id";s:5:"table";s:1:"o";s:3:"def";s:0:"";s:10:"max_length";i:20;s:8:"not_null";i:1;s:11:"primary_key";i:0;s:12:"multiple_key";i:0;s:10:"unique_key";i:0;s:7:"numeric";i:1;s:4:"blob";i:0;s:4:"type";s:3:"int";s:8:"unsigned";i:0;s:8:"zerofill";i:0;s:6:"binary";b:0;}i:1;O:8:"stdClass":14:{s:4:"name";s:5:"count";s:5:"table";s:0:"";s:3:"def";s:0:"";s:10:"max_length";i:21;s:8:"not_null";i:1;s:11:"primary_key";i:0;s:12:"multiple_key";i:0;s:10:"unique_key";i:0;s:7:"numeric";i:1;s:4:"blob";i:0;s:4:"type";s:3:"int";s:8:"unsigned";i:0;s:8:"zerofill";i:0;s:6:"binary";b:0;}}}