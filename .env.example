# ==============================================================================
# Environment Configuration for Revista GEN OJS Docker Stack
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# ==============================================================================

# Web Application Port (host mapping: ${APP_PORT}:80)
# Use 80 for direct HTTP on production, or 8080 if behind a reverse proxy (Nginx, Traefik, etc.)
APP_PORT=8080

# Database Configuration
MYSQL_DATABASE=ojsg
MYSQL_USER=ojs_user
MYSQL_PASSWORD=ojs_password
MYSQL_ROOT_PASSWORD=root_password

# Database Port Exposure
# In production, DO NOT expose 3306 publicly (0.0.0.0).
# Keep 127.0.0.1 so it is only reachable locally on the server host:
DB_BIND_IP=127.0.0.1
DB_PORT=3306

# Host Domain / Base URL Reference
# This should match the `base_url` set in ojs_code/config.inc.php
# Development: http://localhost:8080
# Production:  https://<distribution-id>.cloudfront.net (or your custom domain)
APP_BASE_URL=http://localhost:8080

# ==============================================================================
# Allowed Hostnames & CloudFront Distribution Security
# ==============================================================================
# AWS Lightsail Managed Distributions route traffic through Amazon CloudFront.
# In this architecture:
#
# 1. ALLOWED_HOSTS:
#    Protects origin from raw IP scans, Host header poisoning, and unauthorized
#    domain traffic. Requests with raw IP Host headers (e.g. direct connections
#    to origin IP) or unapproved domains are rejected with 403 Forbidden.
#    - Format: Comma-separated list of allowed hostnames, wildcards, or IPv4/IPv6 addresses.
#
#    SECURITY RECOMMENDATION:
#    While `*.cloudfront.net` works conveniently during initial setup and testing,
#    you should pin your specific Lightsail distribution domain once created in AWS
#    (e.g. `d123456abcdef.cloudfront.net`). Permitting wildcard `*.cloudfront.net`
#    allows any third-party AWS CloudFront/Lightsail distribution that discovers your
#    origin IP to proxy traffic through it (unauthorized distribution binding).
#
#    - Production recommendation (pinned distribution + custom domain):
#        ALLOWED_HOSTS="d123456abcdef.cloudfront.net,revistagen.com,www.revistagen.com,localhost,127.0.0.1,[::1]"
#    - Initial setup / staging example:
#        ALLOWED_HOSTS="*.cloudfront.net,localhost,127.0.0.1"
#    - Local development: Leave empty ("") to disable hostname filtering.
ALLOWED_HOSTS="*.cloudfront.net,localhost,127.0.0.1"

# 2. BLOCK_RAW_IPS:
#    Explicitly blocks incoming requests where the Host header is a raw IPv4 or IPv6
#    address (e.g. 52.205.19.85 or [2001:...]), exempting local loopback (127.0.0.1, [::1])
#    and health checks. Note that raw IPs are also automatically blocked when
#    ALLOWED_HOSTS is defined.
BLOCK_RAW_IPS=false

# 3. REQUIRE_CLOUDFRONT:
#    Lightsail managed distributions do not permit custom secret origin headers,
#    but automatically attach standard CloudFront edge headers:
#    - X-Amz-Cf-Id (unique CloudFront trace ID)
#    - CloudFront-Forwarded-Proto (protocol forwarded by edge)
#    - Via (e.g. "1.1 <id>.cloudfront.net (CloudFront)")
#    When REQUIRE_CLOUDFRONT=true, Apache ensures the request originated from
#    CloudFront. Direct connections bypassing the distribution receive 403 Forbidden.
#    - Production: Set to "true".
#    - Local development: Set to "false".
REQUIRE_CLOUDFRONT=false
